<style>
  /* 1. Container Styling: Added a max-width so it stops stretching */
  .edd-widget {
    margin: 20px 0; 
    padding: 15px 0; 
    border: none; 
    border-top: 1px solid #eaeaea; 
    border-bottom: 1px solid #eaeaea; 
    max-width: 400px; /* This keeps the widget compact and neat */
  }

  .edd-widget h4 {
    margin: 0 0 10px 0;
    font-size: 1em;
  }

  /* 2. Input Group: Keeps them side-by-side but constrained */
  .edd-input-group {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .edd-input-group input {
    width: 200px; /* Fixed width instead of stretching infinitely */
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1em;
  }

  /* 3. Button Styling: Matches your "Buy It Now" button */
  .edd-input-group button {
    padding: 10px 20px;
    background-color: #fff; /* White background */
    color: #000; /* Black text */
    border: 1px solid #000; /* Clean black outline */
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.2s ease;
  }

  /* On hover, it smoothly inverts to black */
  .edd-input-group button:hover {
    background-color: #000 !important;
  color: #ffffff !important;
  }

  #edd-result {
    margin-top: 10px;
    font-size: 0.9em;
  }
</style>

<div class="edd-widget">
  <h4>Check Delivery Estimate</h4>
  <div class="edd-input-group">
    <input type="text" id="pincode-input" placeholder="Enter PIN Code" maxlength="6" />
    <button id="check-delivery-btn">Check</button>
  </div>
  <div id="edd-result"></div>
</div>

<script>
  // 1. Grab the dynamic weight from Shopify
  let productWeightGrams = {{ product.selected_or_first_available_variant.weight | default: 1000 }};
  
  // 2. The Failsafe: If Shopify explicitly says the weight is 0, force it to 1000 grams (1kg)
  if (productWeightGrams === 0) {
    productWeightGrams = 1000; 
  }
  
  // 3. Convert to Kilograms (Shiprocket requires KG)
  const productWeightKg = (productWeightGrams / 1000).toFixed(2);

  document.getElementById('check-delivery-btn').addEventListener('click', async () => {
    
    // 3. Grab the dynamic pincode from the input box
    const pincode = document.getElementById('pincode-input').value.trim();
    const resultDiv = document.getElementById('edd-result');
    
    if(!pincode || pincode.length !== 6) {
      resultDiv.innerText = "Please enter a valid 6-digit pincode.";
      resultDiv.style.color = "red";
      return;
    }

    resultDiv.innerText = "Checking...";
    resultDiv.style.color = "black";

    try {
      // 4. Pass BOTH the dynamic pincode and dynamic weight to your backend
      const response = await fetch(`/apps/shiprocket-edd/delivery?pincode=${pincode}&weight=${productWeightKg}`);
      const data = await response.json();

      if (data.success) {
        resultDiv.innerText = `🚚 Estimated Delivery by ${data.etd} (${data.days} days)`;
        resultDiv.style.color = "green";
      } else {
        resultDiv.innerText = data.message || "❌ Delivery unavailable for this pincode.";
        resultDiv.style.color = "red";
      }
    } catch (err) {
      // CRASH PATH: Customer-friendly fallback if the EC2 server is down
      console.error("Delivery API Error:", err);
      resultDiv.innerText = "⚠️ Delivery estimates are temporarily unavailable. Please proceed to checkout to see options.";
      resultDiv.style.color = "#d9534f";
    }
  });
</script>

{% schema %}
{
  "name": "Delivery Checker",
  "target": "section",
  "settings": []
}
{% endschema %}